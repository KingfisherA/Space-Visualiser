<?xml version="1.0" encoding="utf-8"?>
<AutoVisualizer xmlns="http://schemas.microsoft.com/vstudio/debugger/natvis/2010">

  <Type Name="SV::Array&lt;*&gt;">
    <DisplayString>{{Count = {count}, Capacity = {capacity}}}</DisplayString>
    <Expand>
      <Item Name="[Count]">count</Item>
      <Item Name="[Capacity]">capacity</Item>
      <ArrayItems>
        <Size>count</Size>
        <ValuePointer>internalArray</ValuePointer>
      </ArrayItems>
      <Item Name="[Retraction Increment]">retractionIncrement</Item>
    </Expand>
  </Type>

  <Type Name="SV::ArraySpan&lt;*&gt;">
    <DisplayString>{{Count = {count}}}</DisplayString>
    <Expand>
      <Item Name="[Count]">count</Item>
      <ArrayItems>
        <Size>count</Size>
        <ValuePointer>internalArray</ValuePointer>
      </ArrayItems>
    </Expand>
  </Type>

  <Type Name="SV::ArraySpan&lt;*&gt;">
    <DisplayString>{{Count = {count}}}</DisplayString>
    <Expand>
      <Item Name="[Count]">count</Item>
      <ArrayItems>
        <Size>count</Size>
        <ValuePointer>internalArray</ValuePointer>
      </ArrayItems>
    </Expand>
  </Type>

  <Type Name="SV::ArrayBase&lt;*&gt;">
    <DisplayString>{{Count = {count}}}</DisplayString>
    <Expand>
      <Item Name="[Count]">count</Item>
      <ArrayItems>
        <Size>count</Size>
        <ValuePointer>internalArray</ValuePointer>
      </ArrayItems>
    </Expand>
  </Type>

  <Type Name="SV::ArrayView&lt;*&gt;">
    <DisplayString>{{Length = {arrayLength}}}</DisplayString>
    <Expand>
      <Item Name="[Length]">arrayLength</Item>
      <ArrayItems>
        <Size>arrayLength</Size>
        <ValuePointer>internalArray</ValuePointer>
      </ArrayItems>
    </Expand>
  </Type>

  <Type Name="SV::BasicStringView&lt;*&gt;">
    <DisplayString>{stringData,[stringLength]}</DisplayString>
    <StringView>stringData,[stringLength]</StringView>
    <Expand>
      <Item Name="[Length]">stringLength</Item>
      <Item Name="[Data]">stringData, [stringLength]</Item>
      <ArrayItems>
        <Size>stringLength</Size>
        <ValuePointer>stringData</ValuePointer>
      </ArrayItems>
    </Expand>
  </Type>

  <Type Name="SV::BasicString&lt;*&gt;">
    <DisplayString>{stringData,[stringLength]}</DisplayString>
    <StringView>stringData,[stringLength]</StringView>
    <Expand>
      <Item Name="[Length]">stringLength</Item>
      <Item Name="[Capacity]">stringCapacity</Item>
      <Item Name="[Data]">stringData, [stringLength]</Item>
      <Item Name="[Allocator Store]">allocatorStore</Item>
      <Item Name ="[Optimise Store]">optimiseStore, [STR_OPTIMISE_STORE]</Item>
      <ArrayItems>
        <Size>stringLength</Size>
        <ValuePointer>stringData</ValuePointer>
      </ArrayItems>
    </Expand>
  </Type>

  <Type Name="SV::StringView">
    <DisplayString>{stringData,[length]}</DisplayString>
    <StringView>stringData,[length]</StringView>
    <Expand>
      <Item Name="[Length]">length</Item>
      <Item Name="[Data]">stringData, [length]</Item>
      <ArrayItems>
        <Size>length</Size>
        <ValuePointer>stringData</ValuePointer>
      </ArrayItems>
    </Expand>
  </Type>

</AutoVisualizer>