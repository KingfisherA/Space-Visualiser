//Window Variables
GLFWwindow* mainWindow = null;
uint displayWidth = 800;
uint displayHeight = 500;
int currentMouseButton = -1;
int currentMouseAction = -1;

//Mouse variables
double mouseX = 0;
double lastMouseX = 0;
double mouseDX = 0;
//
double mouseY = 0;
double lastMouseY = 0;
double mouseDY = 0;
//
double lastScrollTime = 0;
double deltaScrollTime = 0;

//Matricies
mat4 projectionMatrix(1.0f);
//mat4 modelMatrixSphere(1.0f);
Transformation sphereTransformation;
Transformation planeTransformation(vec3(0.0f, -1.2f, 0.0f), vector<vec4>{ vec4(1.0f, 0.0f, 0.0f, 90.0f)}, vec3(10.0f));
Transformation torusTransformation(vec3(0.0f), vector<vec4>{vec4(1.0f, 0.0f, 0.0f, 91.0f)}); //* glm::scale(vec3(1.0f, 1.0f, 0.05f))

//Stars
StarRenderer* sRenderer = null;

//Shadow test
vec3 lightPosition(0.0f, 6.0f, 7.0f);
//
VAO* testSphere = null;
VAO* testTorus = null;
VAO* testPlane = null;
ShadowFBO* sFBO = null;
//
Texture* ringTexture = null;
Texture* saturnTexture = null;

//Saturn test
PlanetRingsShader* pRingsProgram = null;
TexturedDiffuseShader* diffuseProgram = null;
AtmosphereShader* atmosphereShader = null;
SphereShadowShader* ringsShader = null;

//Camera variables
Camera mainCamera;

//Current frame time 
float counter = 0.0f;

//Things to do
